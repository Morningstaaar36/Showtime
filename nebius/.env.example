# Showtime: copy this file to .env and set one AI key. Everything else is optional.
# Every other setting, with its default and what it does: .env.reference

# --- 1. The AI ---
# OpenRouter's free NVIDIA Nemotron models (a free key allows about 50 requests a day).
# Any other OpenAI-compatible API works the same way; LLM_PROVIDER=local uses a llama.cpp server
# on this machine (make use-local).
LLM_PROVIDER=openai
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_KEY_FALLBACK=    # optional: spare keys, comma-separated, used in turn when one runs out
# With no key the app still works: tests use rule-based attacks and fixes (Offline).

# --- 2. Where simulations run ---
SANDBOX_PROVIDER=docker            # docker: a sealed container on this machine

# --- 3. Live web search for the red team (optional) ---
TAVILY_API_KEY=

# --- 4. Hosting on a server (docs/HOSTING.md): make cloud-password writes these ---
SITE_ADDRESS=:80
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
