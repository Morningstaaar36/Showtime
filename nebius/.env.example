# Showtime configuration. Copy to .env (make setup does this). Never commit .env.

# --- Providers (switch to Nebius by changing these two lines and adding keys) ---
LLM_PROVIDER=local                 # local | nebius | openai (any OpenAI-compatible API)
SANDBOX_PROVIDER=docker            # docker | nebius

# --- Local LLM (llama-server, started with: make llm-up) ---
# From Docker Compose the API reaches the host via host.docker.internal; natively use 127.0.0.1.
LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_LLM_MODEL=nemotron-nano-9b-v2-q4_k_m
LLM_SUPPORTS_JSON_SCHEMA=true
LLM_TIMEOUT_S=120                  # one model request
AGENT_STEP_TIMEOUT_S=300           # one agent step in total: request, repair round, retries, escalation
MODELS_DIR=./models
LLM_CONTEXT=16384               # tokens; the edit agent's prompt with every edit op needs more than 8192
LLM_CACHE_RAM_MB=512               # llama-server prompt cache in RAM (default 8 GB is too much here)

# --- Nebius Token Factory ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# `make use-nebius` fills these in. Token Factory ids (model catalog, 2026-10-14):
#   fast  nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B   long  nvidia/Nemotron-3_5-Lightning
#   main  nvidia/nemotron-3-super-120b-a12b      judge nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=
MODEL_LONG=
MODEL_MAIN=
MODEL_FALLBACK=   # optional: a second model tried when a role's model fails at the provider
MODEL_JUDGE=
# Prices in USD per 1M tokens, for the cost meter (confirm in the console)
PRICE_FAST_IN=0.06
PRICE_FAST_OUT=0.24
PRICE_LONG_IN=0.06
PRICE_LONG_OUT=0.24
PRICE_MAIN_IN=0.30
PRICE_MAIN_OUT=0.90
PRICE_JUDGE_IN=1.00
PRICE_JUDGE_OUT=3.00

# --- Any other OpenAI-compatible API (LLM_PROVIDER=openai), e.g. for testing with a bigger model ---
# Uses MODEL_* and PRICE_* above. Examples: https://openrouter.ai/api/v1 ·
# https://api.deepseek.com/v1 · https://open.bigmodel.cn/api/paas/v4 (GLM).
# The hackathon submission must run Nemotron on Nebius (LLM_PROVIDER=nebius).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_KEY_FALLBACK=    # optional second key, used when the first is out of credit
# Extra JSON for every hosted request. OpenRouter + Nemotron 3: {"reasoning":{"enabled":false}}
# (otherwise the model can spend its whole reply length thinking and return nothing).
LLM_EXTRA_BODY=
OPENAI_COMPAT_LABEL=CLOUD          # name shown on the provider badge and in reports

# --- Real-place import (OpenStreetMap; free, no key; 1 request/s, cached in cache/osm) ---
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Nebius Sandboxes ---
NEBIUS_SANDBOX_BASE_URL=https://api.tokenfactory.nebius.com/sandboxes
SANDBOX_MAX_PARALLEL=1             # local: 1 (memory); try 4 on Nebius

# --- Simulation sandbox (local Docker) ---
SIM_IMAGE=showtime-sim:latest
SIM_PLATFORM=linux/amd64           # simulation image architecture; explicit on Apple Silicon
SIM_MEM_LIMIT=2g
SIM_CPUS=4
# absolute host path of ./runs when the API runs in Docker
HOST_RUNS_DIR=

# --- Search and weather ---
TAVILY_API_KEY=
TAVILY_MAX_CALLS=20
OFFLINE=false

# --- Caches ---
LLM_CACHE_MODE=record_replay       # off | record | replay | record_replay

# --- Simulation defaults (sources in docs/ASSUMPTIONS.md) ---
MAX_PEOPLE=8000
MAX_SIM_S=900
MAX_WALL_S=600
TIER2_MAX_SIM_S=180
WALK_SPEED_MEAN=1.34
WALK_SPEED_SD=0.26
AGENT_RADIUS=0.22
# time gap to the person ahead (s): 0.25 calibrated on real bottleneck experiments
# (docs/VALIDATION.md); 1.0 is the model's default and lets about half as many people through
AGENT_TIME_GAP=0.25
SPECIFIC_FLOW=1.3
STAIR_SPEED=0.6
STAIR_FLOW=1.0
DENSITY_WARN_PPM2=3.5
DENSITY_DANGER_PPM2=5.0
DANGER_MIN_DURATION_S=5
SAFETY_FACTOR=1.5
PRE_MOVEMENT_S=60
TARGET_EVAC_INDOOR_S=300
TARGET_EVAC_OUTDOOR_S=480

# --- Session budgets ---
MAX_ROUNDS=3
ATTACKS_PER_ROUND=4
FIXES_PER_ATTACK=2
FIX_TARGETS=2
FIX_MIN_GAIN=0.10
SESSION_MAX_TOKENS=400000
SESSION_MAX_RUNS=40
SESSION_MAX_WALL_S=1800

# --- Web origins allowed to call the API (WEB_ORIGIN plus these, comma-separated) ---
# WEB_ORIGIN=http://localhost:5173
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:4173
