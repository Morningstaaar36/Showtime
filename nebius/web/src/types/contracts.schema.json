       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rset S"
    },
    "pre_movement_s": {
     "title": "Pre Movement S",
     "type": "number"
    },
    "safety_factor": {
     "title": "Safety Factor",
     "type": "number"
    },
    "hazard_source": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Hazard Source"
    },
    "hazard_explanation": {
     "default": "",
     "title": "Hazard Explanation",
     "type": "string"
    },
    "rset_source": {
     "default": "",
     "title": "Rset Source",
     "type": "string"
    },
    "formula": {
     "default": "T_latest = T_hazard \u2212 (T_pre_movement + RSET \u00d7 safety factor)",
