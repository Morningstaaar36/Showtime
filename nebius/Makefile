# Showtime — Red Team Night. Run `make help` for the list of targets.
SHELL := /bin/bash
ENV := source scripts/env.sh &&
SIM_PLATFORM ?= linux/amd64
API := cd api &&
.DEFAULT_GOAL := help

.PHONY: help setup get-llm get-model get-data probe llm-up llm-down up down dev dev-down build-sim \
        types check lint typecheck test test-sim test-web e2e smoke smoke-nebius use-nebius use-openrouter use-local demo-precompute \
        clean mem plugins new-plugin calibrate validate screenshots m1-test-init m1-test-up m1-test-start m1-test-down m1-test-status m1-test-logs m1-test-smoke m1-test-p2-02

help: ## Show this help
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[1m%-20s\033[0m %s\n", $$1, $$2}'

setup: ## Install everything (uv, Python 3.12, deps, web deps, sim image, model, data) inside this folder
	@test -f .env || cp .env.example .env
	@./scripts/setup.sh

get-llm: ## Download the prebuilt llama.cpp CUDA server into .tools/
	@./scripts/get_llm.sh

get-model: ## Download Nemotron Nano 9B v2 (Q4_K_M GGUF) into ./models
	@./scripts/get_model.sh

get-data: ## Download the crowd-accident and validation datasets into ./data
	@$(ENV) ./scripts/get_data.sh

probe: ## Check GPU, Docker, LLM (chat + JSON), sim image, weather, search
	@$(ENV) $(API) uv run python ../scripts/probe.py

llm-up: ## Start the local Nemotron server on the GPU (background, logs/llm.log)
	@./scripts/llm_up.sh

llm-down: ## Stop the local LLM server
	@./scripts/llm_down.sh

up: ## Start the stack with Docker Compose (api + web) → http://localhost:5173
	@test -f .env || cp .env.example .env
	@mkdir -p runs cache state data
	@docker compose up -d --build
	@echo "Showtime: http://localhost:5173   (API docs: http://127.0.0.1:8000/api/docs)"
	@echo "Start the local model if it is not running: make llm-up"

down: ## Stop the Docker Compose stack
	@docker compose down

dev: ## Run API + Vite dev server natively (lighter on memory; hot reload)
	@./scripts/dev_up.sh

dev-down: ## Stop the native dev servers
	@./scripts/dev_down.sh

build-sim: ## Build the simulation sandbox image (SIM_PLATFORM defaults to linux/amd64)
	@docker build --platform $(SIM_PLATFORM) -t showtime-sim:latest sim/

m1-test-init: ## Initialize the local M1 test profile; preserve existing .env
	@python3 scripts/m1_test.py init

m1-test-up: ## Build and start the local M1 test stack
	@python3 scripts/m1_test.py up

m1-test-start: ## Start built M1 test images without registry downloads
	@python3 scripts/m1_test.py up --no-build

m1-test-down: ## Stop the M1 test stack, retaining projects and runs
	@python3 scripts/m1_test.py down

m1-test-status: ## Check M1 test services and model/simulation providers
	@python3 scripts/m1_test.py status

m1-test-logs: ## Follow M1 test API and web logs
	@python3 scripts/m1_test.py logs

m1-test-smoke: ## Verify M1 test UI, API, and real simulation without AI calls
	@python3 scripts/m1_test.py smoke

m1-test-p2-02: ## Verify plan constraints and all fast API regressions in the M1 test image
	@mkdir -p cache/uv-tests
	@docker run --rm --platform linux/arm64 -w /app/api \
	  -v "$(CURDIR)/api:/app/api:ro" -v "$(CURDIR)/cache/uv-tests:/root/.cache/uv" \
	  -v "$(CURDIR)/plugins:/app/plugins:ro" \
	  showtime-api:latest uv run --frozen pytest -q -m "not slow" --tb=short \
	  --basetemp=/tmp/showtime-p2-02-tests

types: ## Regenerate TypeScript types from the Pydantic contracts
	@$(ENV) $(API) uv run python ../scripts/export_schemas.py ../web/src/types/contracts.schema.json
	@$(ENV) cd web && npx json2ts -i src/types/contracts.schema.json -o src/types/generated.ts --unreachableDefinitions \
	  --bannerComment "/* Generated by make types from the Pydantic contracts (api/models). Do not edit. */"

lint: ## ruff (Python), eslint (web), import boundaries
	@$(ENV) $(API) uv run ruff check . ../plugins ../scripts ../sim && uv run ruff format --check -q . ../plugins ../scripts ../sim && uv run lint-imports --config ../.importlinter
	@$(ENV) cd web && npx eslint src --max-warnings=0

typecheck: ## mypy --strict on core/adapters/orchestrator, tsc
	@$(ENV) uv run --project api mypy --config-file api/pyproject.toml api/core api/adapters api/orchestrator
	@$(ENV) cd web && npx tsc -b --noEmit

check: lint typecheck ## Lint, typecheck and fast unit tests
	@$(ENV) $(API) uv run pytest -q -m "not slow"

test: ## Full Python tests including simulation tests (needs Docker)
	@$(ENV) $(API) uv run pytest -q tests ../sim/tests

test-sim: ## Simulation tests only
	@$(ENV) $(API) uv run pytest -q ../sim/tests

test-web: ## Frontend unit tests
	@$(ENV) cd web && npx vitest run

e2e: ## Playwright journeys (needs the app running)
	@$(ENV) cd web && npx playwright test

smoke: ## End-to-end smoke test against the running API (small crowd)
	@$(ENV) $(API) uv run python ../scripts/smoke.py

smoke-nebius: ## Smoke test against Nebius Token Factory + Sandboxes (skips without keys)
	@$(ENV) $(API) uv run python ../scripts/smoke_nebius.py

use-nebius: ## Point .env at Nebius Token Factory (Nemotron ids, prices); keeps keys, backs up .env
	@python3 scripts/switch_provider.py nebius

use-openrouter: ## Point .env at OpenRouter (free Nemotron); keeps keys, backs up .env
	@python3 scripts/switch_provider.py openrouter

use-local: ## Point .env at the local llama-server model; keeps keys, backs up .env
	@python3 scripts/switch_provider.py local

demo-precompute: ## Precompute the three demo projects (runs simulations and agents)
	@$(ENV) $(API) uv run python ../scripts/precompute_demos.py

calibrate: ## Compare instant estimates with simulations on every template
	@$(ENV) $(API) uv run python ../scripts/calibrate_tier1.py

validate: ## Simulator vs the Jülich 2006 bottleneck experiment -> api/data/validation.json (needs get-data)
	@$(ENV) $(API) uv run python ../scripts/validate_bottleneck.py

screenshots: ## Screenshot every screen into docs/screenshots (app must be running)
	@$(ENV) cd web && node e2e/screens.mjs ../docs/screenshots

clean: ## Remove runs, temp caches and Showtime containers (keeps models, data, projects)
	@rm -rf runs/r_* runs/_* cache/tmp
	@docker ps -aq --filter label=com.showtime.project=true | xargs -r docker rm -f >/dev/null
	@echo "cleaned"

mem: ## Memory, GPU and container usage
	@free -h | head -2
	@nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>/dev/null || true
	@docker stats --no-stream --format "table {{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}" 2>/dev/null | head -8

plugins: ## List discovered plugins with status
	@$(ENV) $(API) uv run python ../scripts/list_plugins.py

new-plugin: ## Scaffold a plugin: make new-plugin TYPE=HazardSource ID=hazard_flood
	@$(ENV) $(API) uv run python ../scripts/new_plugin.py "$(TYPE)" "$(ID)"
