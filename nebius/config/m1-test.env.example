# Local M1 test profile: make m1-test-init; add an OpenRouter key only for AI calls.
LLM_PROVIDER=openai
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_LABEL=OPENROUTER
MODEL_FAST=nvidia/nemotron-3-super-120b-a12b:free
MODEL_LONG=nvidia/nemotron-3-super-120b-a12b:free
MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b:free
MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b:free
LLM_SUPPORTS_JSON_SCHEMA=false
LLM_EXTRA_BODY='{"reasoning":{"enabled":false}}'
LLM_FALLBACK=none
LLM_CACHE_MODE=record_replay
SANDBOX_PROVIDER=docker
SANDBOX_MAX_PARALLEL=1
SIM_PLATFORM=linux/amd64
SIM_IMAGE=showtime-sim:latest
SIM_MEM_LIMIT=2g
SIM_CPUS=2
SIM_USER=10001:10001
TAVILY_API_KEY=
OFFLINE=false
# Start with small sessions to conserve free API requests and M1 memory.
MAX_ROUNDS=1
ATTACKS_PER_ROUND=2
FIXES_PER_ATTACK=1
FIX_TARGETS=1
SESSION_MAX_RUNS=12
SESSION_MAX_WALL_S=1800
